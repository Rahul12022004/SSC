# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database ──────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/SSC

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=at-least-32-random-characters-here
JWT_EXPIRES_IN=7d
SESSION_SECRET=at-least-16-random-characters-here

# ── CORS — Vercel frontend URL (comma-separate multiple) ──────────────
CLIENT_URL=https://your-app.vercel.app

# ── File storage ──────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Cloudinary (image uploads) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email OTP ─────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=auth@yourdomain.com

# ── reCAPTCHA ─────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=
