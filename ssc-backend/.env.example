# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/SSC

# Auth
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_EXPIRES_IN=7d
SESSION_SECRET=change-me-to-at-least-16-random-characters

# CORS — set to your Vercel frontend URL in production
CLIENT_URL=https://your-app.vercel.app

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — for OTP emails
RESEND_API_KEY=
RESEND_FROM=auth@yourdomain.com

# reCAPTCHA (optional)
RECAPTCHA_SECRET_KEY=

# Vercel Blob (optional)
BLOB_READ_WRITE_TOKEN=
